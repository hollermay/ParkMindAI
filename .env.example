# ─── LLM Configuration ────────────────────────────────────────────────────────
# Choose your LLM provider: groq | gemini | openai | mock
LLM_PROVIDER=groq

# Groq (recommended — fast, free tier available: console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── Embedding Configuration ──────────────────────────────────────────────────
# Set to "true" to use OpenAI embeddings (requires OPENAI_API_KEY)
# Set to "false" to use local sentence-transformers (no API key needed)
USE_OPENAI_EMBEDDINGS=false
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Vector Store Configuration ───────────────────────────────────────────────
# Options: "weaviate" (cloud/local, recommended) or "chroma" (local fallback)
VECTOR_STORE_TYPE=weaviate
CHROMA_PERSIST_DIR=./data/chroma_db

# ─── Weaviate Configuration ────────────────────────────────────────────────────────────────
# Get a free cluster at: https://console.weaviate.cloud
# Weaviate Cloud (WCD): set both WEAVIATE_URL and WEAVIATE_API_KEY
# Local Docker:         set WEAVIATE_URL=http://localhost:8080, leave API_KEY blank
WEAVIATE_URL=https://your-cluster.weaviate.network
WEAVIATE_API_KEY=your_weaviate_api_key_here

# ─── Database Configuration (PostgreSQL) ──────────────────────────────────────────────────────────────────
# Full SQLAlchemy connection URL to your PostgreSQL database.
# Create the database first:  createdb smartpark
# Examples:
#   postgresql://postgres:password@localhost:5432/smartpark
#   postgresql+psycopg2://user:password@host:5432/smartpark
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartpark
# Fallback to local SQLite when DATABASE_URL is not set (development only):
# DATABASE_URL=sqlite:///./data/parking.db

# ─── Application Settings ─────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Admin password for human-in-the-loop approval console
ADMIN_PASSWORD=admin123

# ─── Admin Agent (Second Agent) ───────────────────────────────────────────────
# REST API port where the admin dashboard is served
ADMIN_API_HOST=localhost
ADMIN_API_PORT=5001
# Set to true to disable the terminal prompt and wait for REST API decision only
ADMIN_API_ONLY=false
# Seconds to wait for admin response before falling back to terminal (API-only mode)
ADMIN_DECISION_TIMEOUT=120

# Email notification (optional — leave SMTP_HOST blank to disable)
ADMIN_EMAIL=admin@yourcompany.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=parkbot@smartpark.com

# ─── LangSmith (optional — tracing, monitoring & Studio UI) ─────────────────────
# Get your API key at: https://smith.langchain.com
# Set LANGCHAIN_TRACING_V2=true to enable run tracing in LangSmith.
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=smartpark-chatbot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── RAG Settings ─────────────────────────────────────────────────────────────
TOP_K_DOCUMENTS=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50
